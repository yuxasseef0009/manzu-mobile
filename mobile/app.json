{
  "expo": {
    "name": "Manzu Pharmacy",
    "slug": "manzu-pharmacy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ng.manzu.pharmacy"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "ng.manzu.pharmacy"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 120,
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Manzu Pharmacy uses your location to pin your pharmacy on the map."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Manzu Pharmacy accesses your photos so you can upload a pharmacy logo.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "react-native-maps"
    ],
    "scheme": "manzu-pharmacy",
    "experiments": {
      "typedRoutes": true
    }
  }
}
