# Base URL of manzu-b (med-version), no trailing slash. Required.
EXPO_PUBLIC_API_URL=http://localhost:5000

# Push notifications (PLAN G4/D6). Off until the backend sends pushes; needs a dev/store build + EAS_PROJECT_ID.
EXPO_PUBLIC_PUSH_ENABLED=false

# Build-time only (read by app.config.ts, not bundled into JS).
# EAS project UUID from `npx eas-cli@latest init`; required for Expo push tokens.
EAS_PROJECT_ID=
# Google Maps key for Android standalone builds (react-native-maps). Not needed in Expo Go.
GOOGLE_MAPS_API_KEY=
